NODE_ENV=development
PORT=3000
API_PREFIX=api
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/db_name?schema=public
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
SESSION_COOKIE_NAME=session
SESSION_IDLE_TIMEOUT_SECONDS=86400
SESSION_ABSOLUTE_TIMEOUT_SECONDS=604800
SESSION_ACTIVITY_REFRESH_SECONDS=3600
SESSION_SECURE=false
SESSION_SAME_SITE=lax
SWAGGER_ENABLED=true
SEED_ADMIN_EMAIL=test@example.com
SEED_ADMIN_PASSWORD=change-me
SEED_ADMIN_NAME=Development Admin

POSTGRES_DB=db_name
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
